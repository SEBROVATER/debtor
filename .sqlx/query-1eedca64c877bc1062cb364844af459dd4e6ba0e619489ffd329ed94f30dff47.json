  "query": "SELECT s.id, s.description, s.total_amount, s.currency, s.spending_type, s.spent_date, p.id AS payer_id, sp.paid_amount AS payer_amount, p.name AS payer_name, p.color AS payer_color, p.is_archived AS payer_archived FROM spendings s LEFT JOIN spending_payers sp ON sp.spending_id = s.id LEFT JOIN participants p ON p.id = sp.participant_id AND p.group_id = ? WHERE s.group_id = ? AND (s.spent_date > ? OR (s.spent_date = ? AND s.id > ?)) ORDER BY s.spent_date ASC, s.id ASC LIMIT 26",
